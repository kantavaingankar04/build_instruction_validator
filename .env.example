# Server port (default: 3000)
PORT=3000

# GitHub Personal Access Token (optional — enables live PR creation on your fork)
# Generate at: https://github.com/settings/tokens (scope: repo)
GITHUB_TOKEN=

# Ollama model used by the Python pipeline for semantic extraction
# Ensure this model is pulled locally: ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b
